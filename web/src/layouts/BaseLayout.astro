---
import Analytics from "@vercel/analytics/astro"

import ThemeToggle from "@/components/ui/ThemeToggle.astro"
import "@/styles/global.css"
import { ClientRouter } from "astro:transitions"

interface Props {
  title?: string
  description?: string
  image?: string
}

const {
  title = "Oleksandr Hryhorchuk - frontend developer",
  description = "portfolio of Oleksandr Hryhorchuk, a react and typescript frontend developer.",
  image = "/preview.jpg",
} = Astro.props

const canonicalUrl = Astro.url.href.replace(/\/$/, "")
const ogImageUrl = new URL(image, Astro.site ?? Astro.url).href
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <link rel="icon" href="data:," transition:persist="favicon" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <link rel="canonical" href={canonicalUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <slot name="head" />
    <script>
      import { startFaviconBlink } from "@/favicon"
      import { startTheme } from "@/lib/theme"

      startFaviconBlink()
      startTheme()

      document.addEventListener("astro:before-swap", (event) => {
        event.newDocument.documentElement.className =
          document.documentElement.className
      })
    </script>
    <ClientRouter />
    <Analytics />
  </head>
  <body>
    <slot />
    <ThemeToggle />
  </body>
</html>
