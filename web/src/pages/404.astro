---
import ArrowLeftLine from "@/components/icons/ArrowLeftLine.astro"
import BaseLayout from "@/layouts/BaseLayout.astro"
---

<BaseLayout>
  <main class="flex min-h-svh items-center justify-center px-4 py-6 sm:px-6">
    <div class="flex w-full max-w-2xl flex-col gap-6 text-left">
      <div class="flex flex-col gap-3">
        <p class="font-heading text-xs text-muted-foreground uppercase">404</p>
        <h1 class="font-heading text-3xl text-foreground sm:text-5xl">
          project not found
        </h1>
        <p
          class="max-w-prose font-sans text-sm leading-6 text-muted-foreground sm:text-base"
        >
          We could not find a project for this slug.
        </p>
        <a
          href="/"
          class="inline-flex items-center gap-2 self-start border border-border bg-transparent px-4 py-2 font-heading text-xs text-muted-foreground lowercase transition-colors hover:text-foreground"
        >
          <ArrowLeftLine />
          back home
        </a>
      </div>
    </div>
  </main>
</BaseLayout>
