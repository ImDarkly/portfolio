{
  "ci": {
    "collect": {
      "staticDistDir": "./dist",
      "url": ["/index.html", "/project/mova/index.html"],
      "numberOfRuns": 3
    },
    "assert": {
      "includePassedAssertions": true,
      "assertions": {
        "categories:performance": ["error", { "minScore": 0.9 }],
        "categories:accessibility": ["error", { "minScore": 0.95 }]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": "./.lighthouseci"
    }
  }
}
